{
  "name": "hpcgpt",
  "version": "0.1.2",
  "description": "Single-command CLI to launch Opencode preconfigured for NCSA HPC (HPCGPT)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hpcgpt": "bin/hpcgpt.js"
  },
  "files": [
    "bin/",
    "opencode.jsonc",
    "prompts/",
    "mcp_servers/illinois_chat_server/dist/",
    "mcp_servers/slurm_mcp_server/dist/",
    "scripts/postinstall.cjs",
    "favicon.png",
    "example.env"
  ],
  "scripts": {
    "install:servers": "cd mcp_servers/illinois_chat_server && bun install && cd ../slurm_mcp_server && bun install && cd ../..",
    "install:jira": "mkdir -p containers && apptainer pull containers/atlassian-mcp-server.sif docker://ghcr.io/sooperset/mcp-atlassian:latest",
    "build:illinois": "cd mcp_servers/illinois_chat_server && bun run build",
    "build:slurm": "cd mcp_servers/slurm_mcp_server && bun run build",
    "build": "bun run install:servers && bun run build:illinois && bun run build:slurm",
    "build:dist": "bun run ./script/build.ts",
    "postinstall": "node scripts/postinstall.cjs",
    "slurm-mcp-server": "node mcp_servers/slurm_mcp_server/dist/index.js",
    "illinois-chat-mcp-server": "node mcp_servers/illinois_chat_server/dist/index.js",
    "atlassian-mcp-server": "apptainer run --env-file .env.atlassian containers/atlassian-mcp-server.sif"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Center-for-AI-Innovation/hpcgpt.git",
    "directory": "packages/hpcgpt"
  }
}
